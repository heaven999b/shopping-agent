{
  "_comment": "RL 训练专用配置，覆盖 default.json 中的 rl 部分",
  "agent": {
    "use_rl": true
  },
  "rl": {
    "clar_lr": 3e-4,
    "plan_lr": 3e-4,
    "critic_lr": 5e-4,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "episodes_per_iter": 64,
    "num_iterations": 300,
    "eval_interval": 25,
    "save_interval": 50
  }
}
